project_id       = "your-gcp-project-id"
region           = "us-central1"
environment      = "production"
alert_email      = "ops@example.com"
github_owner     = "your-github-account"
github_repository = "lanka-law-bot"

# Bootstrap with an already-pushed tag. Cloud Build deploys immutable SHA tags later.
backend_image  = "us-central1-docker.pkg.dev/your-gcp-project-id/lankalawbot/backend:bootstrap"
frontend_image = "us-central1-docker.pkg.dev/your-gcp-project-id/lankalawbot/frontend:bootstrap"

# Enable only after the GitHub connection exists in Cloud Build.
create_cloud_build_trigger = false

backend_env_vars = {
  FIREBASE_PROJECT_ID                  = "your-firebase-project"
  NEO4J_URI                           = "neo4j+s://example.databases.neo4j.io"
  NEO4J_USER                          = "neo4j"
  NEO4J_DATABASE                      = "neo4j"
  PINECONE_INDEX_HOST                 = "https://example.svc.pinecone.io"
  PINECONE_LEGAL_INDEX_HOST           = "https://example.svc.pinecone.io"
  PINECONE_LEGAL_BM25_INDEX_HOST      = "https://example.svc.pinecone.io"
  LANGSMITH_TRACING                   = "true"
  LANGSMITH_PROJECT                   = "LawDex"
}

frontend_build_vars = {
  NEXT_PUBLIC_FIREBASE_API_KEY             = "public-firebase-api-key"
  NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN         = "project.firebaseapp.com"
  NEXT_PUBLIC_FIREBASE_PROJECT_ID          = "your-firebase-project"
  NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET      = "project.firebasestorage.app"
  NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID = "000000000000"
  NEXT_PUBLIC_FIREBASE_APP_ID              = "1:000000000000:web:example"
  NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID      = "G-EXAMPLE"
}
